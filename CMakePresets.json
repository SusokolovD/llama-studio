{
  "version": 6,
  "cmakeMinimumRequired": {"major": 4, "minor": 2, "patch": 0},
  "configurePresets": [
    {
      "name": "msvc2026-static-x64",
      "displayName": "MSVC 2026 x64 / static Qt / MT",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-msvc2026-static",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_MSVC_STATIC_ROOT}",
        "LLAMA_STUDIO_STATIC_MSVC": "ON",
        "LLAMA_STUDIO_STATIC_QT": "ON",
        "LLAMA_STUDIO_MSVC_RUNTIME": "MultiThreaded",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "msvc2026-static-x64", "configurePreset": "msvc2026-static-x64", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "msvc2026-static-x64", "configurePreset": "msvc2026-static-x64", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}

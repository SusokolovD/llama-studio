QWidget { background: #12151c; color: #e3e7f0; font-family: 'Segoe UI'; font-size: 13px; }
QMainWindow, QDialog { background: #12151c; }
QLabel#title { font-size: 27px; font-weight: 700; }
QLabel#version { color: #a4c8ff; background: #263855; border-radius: 6px; padding: 5px 9px; font-weight: 600; }
QLabel#subtitle { color: #929eb5; }
QLabel, QCheckBox { background: transparent; }
QLabel#status { background: #222b3d; border-radius: 12px; padding: 8px 18px; color: #9ebaff; }
QFrame#card { background: #1a1f2a; border: 1px solid #2c3445; border-radius: 10px; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #202735; border: 1px solid #354158; border-radius: 6px; padding: 7px; selection-background-color: #4675dc; min-height: 19px; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #7d9dff; }
QWidget:disabled { color: #626e84; }
QPushButton { background: #293246; border: 1px solid #394660; border-radius: 6px; padding: 0; min-height: 32px; min-width: 24px; }
QPushButton[fullHit="true"] { padding: 8px 15px; min-height: 0; min-width: 0; }
QPushButton:hover { background: #354565; border-color: #7798e0; }
QPushButton#primary { background: #587ce5; color: white; border: none; font-weight: 600; }
QPushButton#danger { color: #ff9ca7; }
QPushButton:disabled { background: #202633; color: #667087; border-color: #2b3241; }
QListWidget { border: none; background: #171c26; border-radius: 8px; padding: 8px; }
QListWidget::item { padding: 13px 10px; border-radius: 6px; margin-bottom: 4px; }
QListWidget::item:selected { background: #2e3e63; color: #b9ceff; }
QPlainTextEdit { background: #10141c; border: 1px solid #2c3445; border-radius: 6px; padding: 8px; font-family: Consolas; font-size: 12px; }
QScrollArea { border: none; }
QTabWidget::pane { border: none; padding-top: 8px; }
QTabBar::tab { padding: 11px 24px; background: #1a202d; color: #99a8c3; }
QTabBar::tab:selected { background: #2a3959; color: #d1dfff; border-bottom: 2px solid #7d9dff; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 17px; height: 17px; border: 1px solid #667995; border-radius: 4px; background: #202735; }
QCheckBox::indicator:checked { background: #7da2ff; border: 3px solid #c0d2ff; width: 13px; height: 13px; }
QCheckBox::indicator:disabled { border-color: #354158; background: #1b202a; }
QScrollBar:vertical { background: #151b25; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #3a4963; min-height: 30px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QSplitter::handle { background: #242c3b; height: 6px; width: 6px; }
QToolTip { background: #263249; color: #edf2ff; border: 1px solid #52698f; padding: 6px; }
QTextBrowser { background: #171c26; border: 1px solid #354158; border-radius: 8px; padding: 12px; }
QTableWidget { background: #171c26; gridline-color: #354158; }
QTableWidget::item:selected { background: #354565; color: #eef3ff; }
QHeaderView::section { background: #293246; color: #e3e7f0; border: 1px solid #354158; padding: 5px; }
QProgressBar { border: 1px solid #354158; border-radius: 5px; background: #171c26; text-align: center; min-height: 22px; }
QProgressBar::chunk { background: #587ce5; border-radius: 4px; }
QGroupBox { border: 1px solid #354158; border-radius: 8px; margin-top: 12px; padding: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; }
